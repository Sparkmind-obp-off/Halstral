{
  "name": "halstral-control-plane",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist --d1=halstral-production --local --ip 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply halstral-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply halstral-production --remote"
  },
  "dependencies": {
    "hono": "^4.9.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.37.1"
  }
}
